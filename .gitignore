# Python artifacts
venv
__pycache__/
*.pyc

# macOS artifacts
.DS_Store

# Fishwrap generated artifacts (relative to repo root)
logs/
*.db
*.sqlite
articles_db.json
run_sheet.json
enhanced_issue.json
transparency_fragment.html
publication_stats.json

# User specific deployments (like The Daily Clamour)
daily_clamour/data/*
!daily_clamour/data/.gitkeep
daily_clamour/output/*
!daily_clamour/output/.gitkeep
daily_clamour/secrets.json

# Demo artifacts (Keep the structure, ignore the data)
demo/data/*
!demo/data/.gitkeep
demo/output/*
!demo/output/.gitkeep
demo/secrets.json
# NLTK Data (Downloaded by install_venv.sh)
nltk_data/

# Local venv variants (canonical name is venv/, above)
.venv/

# Deploy-time artifacts assembled by .github/workflows/demos.yml.
# Each demos.yml run rebuilds these into docs/demo/<vertical>/ from the
# theme tree before Jekyll. Tracking them in git creates stale state
# (files removed in source linger in the deployed tree forever).
docs/demo/*/index.html
docs/demo/*/static/
